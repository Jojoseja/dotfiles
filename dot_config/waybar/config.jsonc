// -*- mode: jsonc -*-
{
    // "layer": "top", // Waybar at top layer
    // "position": "bottom", // Waybar position (top|bottom|left|right)
    //"height": 30, // Waybar height (to be removed for auto height)
    // "width": 1280, // Waybar width
    "spacing": 4, // Gaps between modules (4px)
    
    //Choose the output of waybar
    //"output": ["DP-1", "HDMI-A-1, HDMI-A-2" ],

    "include": [
        "~/.config/waybar/modules/hyprland.jsonc",
        "~/.config/waybar/modules/cava.jsonc",
        "~/.config/waybar/modules/mpris.jsonc",
        "~/.config/waybar/modules/clock-date.jsonc",
        "~/.config/waybar/modules/clock-time.jsonc",
        "~/.config/waybar/modules/privacy.jsonc",
        "~/.config/waybar/modules/network.jsonc",
        "~/.config/waybar/modules/bluetooth.jsonc",
        "~/.config/waybar/modules/pulseaudio.jsonc",
        "~/.config/waybar/modules/tray.jsonc",

        "~/.config/waybar/modules/custom/notifications.jsonc",
        "~/.config/waybar/modules/custom/filler.jsonc",
        "~/.config/waybar/modules/custom/system.jsonc"
    ],

    // Choose the order of the modules
    "modules-left": [
        "hyprland/workspaces", 
        "cava",
        "mpris"         
    ],
    "modules-center": [
        "hyprland/window"
    ],

    "modules-right": [
        "cpu",
        "memory",
        "disk",
        "pulseaudio",
        "clock#date",
        "clock#time",
        "tray",
        "custom/notifications" 
    ]
}
